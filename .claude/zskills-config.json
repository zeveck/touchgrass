{
  "$schema": "./zskills-config.schema.json",
  "project_name": "touchgrass",
  "timezone": "America/New_York",
  "execution": {
    "landing": "direct",
    "main_protected": false,
    "branch_prefix": "feat/"
  },
  "testing": {
    "unit_cmd": "shopt -s globstar; node --test test/**/*.test.mjs",
    "full_cmd": "bash scripts/test-all.sh",
    "output_file": "/tmp/zskills-tests/touchgrass/.test-results.txt",
    "file_patterns": ["test/**/*.test.mjs", "e2e/**/*.spec.mjs"]
  },
  "dev_server": {
    "cmd": "python3 -m http.server $DEV_PORT --directory game",
    "port_script": "scripts/port.sh",
    "main_repo_path": "/workspaces/touchgrass"
  },
  "ui": {
    "file_patterns": "game/src/.*\\.(mjs|js|css|html)$",
    "auth_bypass": ""
  },
  "ci": {
    "auto_fix": true,
    "max_fix_attempts": 2
  }
}
