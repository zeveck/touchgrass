# Touch Grass -- example environment file.
#
# Both variables are OPTIONAL at runtime: the shipped game loads audio,
# textures, and other assets from `assets/` regardless of whether these
# are set. They are REQUIRED only for Phase 6 asset regeneration
# (OpenAI for images, ElevenLabs for audio). Copy this file to `.env`
# and fill in values if you plan to regenerate assets locally.

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
